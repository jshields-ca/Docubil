# Keep the image to what the app needs at runtime. The runtime stage does
# `COPY . .`, so anything not listed here ends up in the image, including a
# developer's .env, local node_modules (which would replace the clean
# production install), and any PDFs left in the working directories.

# Secrets and local configuration
.env
.env.*
!.env.example

# Dependencies and build output (installed or built inside the image)
node_modules
client/node_modules
public
coverage

# Runtime data: uploaded and remediated PDFs, reports, the job store
uploads
output
reports
data
logs
*.log

# Not needed at runtime
.git
.github
.husky
.changeset
.claude
docs
tests
**/__pycache__
*.pyc

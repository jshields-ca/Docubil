{
  "name": "docubil",
  "version": "0.1.0",
  "description": "Web application for PDF accessibility evaluation and automatic remediation.",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm install --prefix client && npm run build --prefix client",
    "test": "jest --testEnvironment=node --forceExit",
    "test:watch": "jest --testEnvironment=node --watch",
    "test:coverage": "jest --testEnvironment=node --coverage --forceExit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky install",
    "release": "standard-version",
    "changelog": "standard-version --dry-run"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "commitizen": "^4.0.0",
    "cz-git": "^1.14.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "standard-version": "^9.0.0",
    "supertest": "^7.3.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "pdf",
    "accessibility",
    "wcag",
    "remediation",
    "a11y"
  ],
  "author": "Jeremy Shields",
  "repository": {
    "type": "git",
    "url": "https://github.com/jshields-ca/Docubil.git"
  },
  "license": "AGPL-3.0-only"
}
